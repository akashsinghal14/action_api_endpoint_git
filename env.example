# OpenAI API Keys - Map client keys to real OpenAI keys
# Copy this file to .env and add your actual API keys
# Format: CLIENT_KEY=real_openai_key_here

# Default API key (used when client sends "YOUR_KEY")
YOUR_KEY=sk-your-actual-openai-key-here

# Development API key
DEV_KEY=sk-dev-openai-key-here

# Production API key  
PROD_KEY=sk-prod-openai-key-here

# Test API key
TEST_KEY=sk-test-openai-key-here

# Default AI model
DEFAULT_AI_MODEL=gpt-3.5-turbo
